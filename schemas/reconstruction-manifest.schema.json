{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ElPape77/notons-off-reconstruction/raw/main/schemas/reconstruction-manifest.schema.json",
  "title": "Notons Open Food Facts reconstruction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "documentKind",
    "containsDatabaseRows",
    "containsNotonsData",
    "databaseLicense",
    "contentsLicense",
    "imageLicense",
    "upstream",
    "transformation",
    "output",
    "notices"
  ],
  "properties": {
    "formatVersion": { "const": 2 },
    "documentKind": { "const": "odbl-4.6b-reconstruction-method" },
    "containsDatabaseRows": { "const": false },
    "containsNotonsData": { "const": false },
    "databaseLicense": { "const": "ODbL-1.0" },
    "contentsLicense": { "const": "DbCL-1.0" },
    "imageLicense": { "const": "CC-BY-SA-3.0" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceUrl",
        "sourcePublishedAt",
        "sourceRetrievedAt",
        "archiveFilename",
        "archiveBytes",
        "archiveSha256"
      ],
      "properties": {
        "name": { "const": "Open Food Facts" },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://(?:static|world)\\.openfoodfacts\\.org/[^?#]+$"
        },
        "sourcePublishedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "sourceRetrievedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "archiveFilename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+\\.tsv\\.gz$"
        },
        "archiveBytes": { "type": "integer", "minimum": 1 },
        "archiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutableCodeUrl",
        "revision",
        "methodDocument",
        "entrypoint",
        "files",
        "fullSnapshotArguments"
      ],
      "properties": {
        "immutableCodeUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/ElPape77/notons-off-reconstruction/tree/(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "methodDocument": {
          "const": "docs/open-food-facts-reconstruction-method.md"
        },
        "entrypoint": { "const": "npm run catalog:off-reconstruct --" },
        "files": {
          "type": "array",
          "minItems": 20,
          "uniqueItems": true,
          "contains": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "const": "ops/off-catalog/migrations/012_attested_migration_ledger.sql"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {
                    "const": "packages/catalog-import/src/verified-archive-snapshot.ts"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:docs|ops|packages)/[a-zA-Z0-9_./-]+$|^(?:package(?:-lock)?\\.json|tsconfig\\.base\\.json)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "fullSnapshotArguments": {
          "type": "array",
          "minItems": 20,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "schema",
        "runtimeRelation",
        "status",
        "processedRows",
        "rejectedRows",
        "filteredRows",
        "stagedRows",
        "projectionFingerprint",
        "importerVersion",
        "projectionVersion",
        "contractVersion",
        "excludedDomains"
      ],
      "properties": {
        "database": { "const": "notons_off_catalog" },
        "schema": { "const": "off_catalog" },
        "runtimeRelation": { "const": "off_catalog.products_published" },
        "status": { "enum": ["active", "already-active"] },
        "processedRows": { "type": "integer", "minimum": 1 },
        "rejectedRows": { "type": "integer", "minimum": 0 },
        "filteredRows": { "const": 0 },
        "stagedRows": { "type": "integer", "minimum": 1 },
        "projectionFingerprint": {
          "type": "string",
          "pattern": "^[0-9]+\\|-?[0-9]+\\|-?[0-9]+$"
        },
        "importerVersion": { "type": "string", "minLength": 1 },
        "projectionVersion": { "type": "string", "minLength": 1 },
        "contractVersion": { "const": "notons-off-reconstruction/1" },
        "excludedDomains": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "accounts",
              "profiles",
              "reviews",
              "ratings",
              "favorites",
              "scans",
              "moderation",
              "submissions",
              "private photos"
            ]
          }
        }
      }
    },
    "notices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "noPublicDump", "compliancePath"],
      "properties": {
        "database": {
          "const": "Contains information from Open Food Facts, made available under ODbL 1.0."
        },
        "noPublicDump": { "const": true },
        "compliancePath": {
          "const": "ODbL 1.0 section 4.6(b): complete method of alterations"
        }
      }
    }
  }
}
