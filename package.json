{
  "name": "notons-off-reconstruction",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible Open Food Facts catalogue reconstruction method used by Notons",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "catalog:check": "npm run catalog:check -w @notons/catalog-import --",
    "catalog:off-init": "npm run catalog:off-init -w @notons/catalog-import --",
    "catalog:off-reconstruct": "npm run catalog:off-reconstruct -w @notons/catalog-import --",
    "catalog:off-manifest": "npm run catalog:off-manifest -w @notons/catalog-import --",
    "test": "npm run test --workspaces --if-present && npm run test:boundary",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:boundary": "node scripts/check-public-boundary.mjs",
    "test:off-db": "node scripts/run-off-catalog-smokes.mjs",
    "test:off-e2e": "node scripts/run-off-reconstruction-e2e.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifest:verify": "node scripts/verify-reconstruction-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "prettier": "^3.6.2",
    "vitest": "^4.1.10"
  }
}
